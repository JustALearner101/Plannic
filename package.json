{
  "name": "plannic",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "plan": "bun run --preload ./apps/cli/node_modules/@opentui/solid/scripts/preload.js apps/cli/src/index.tsx",
    "dev:cli": "bun run --preload ./apps/cli/node_modules/@opentui/solid/scripts/preload.js apps/cli/src/index.tsx",
    "dev:mcp": "bun run apps/mcp-server/src/index.ts",
    "dev:desktop": "bun run --filter @plannic/desktop tauri -- dev",
    "dev:web": "bun run --filter @plannic/desktop dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test:all": "bun run packages/fs/scripts/run-all-tests.ts && bun test packages/headless/test && bun test apps/cli/src && bun run scripts/verify-skills-sync.ts && bun run scripts/verify-config-docs.ts",
    "test:watch": "bun run packages/fs/scripts/run-all-tests.ts --watch",
    "test:e2e": "bun run e2e/runner.ts",
    "test:smoke": "bun run scripts/smoke-test.ts",
    "benchmark:planning": "bun run benchmarks/planning/runner.ts",
    "headless": "bun run packages/headless/src/index.ts",
    "build:headless": "bun run build:plannic",
    "build:plannic": "bun run scripts/build-cli.ts",
    "generate:agent-assets": "bun run scripts/generate-agent-assets.ts",
    "sync:skills": "bun run scripts/sync-skills.ts",
    "verify:skills": "bun run scripts/verify-skills-sync.ts",
    "verify:config-docs": "bun run scripts/verify-config-docs.ts",
    "migrate-docs": "bun run packages/fs/scripts/migrate-docs.ts",
    "bump": "bun run scripts/bump-version.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "version": "0.3.2"
}
